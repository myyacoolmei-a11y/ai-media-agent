NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production admin invite. Never commit a password.
# ADMIN_EMAIL=you@example.com

# Super Admin emails that can see and manage every brand.
# Comma-separated. Do not include the limited 風曝 editor cfac07151025.
# SUPER_ADMIN_EMAIL=you@example.com

OPENAI_API_KEY=your-openai-api-key
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini

# Optional overrides. Bundled binaries are used when these are empty.
FFMPEG_PATH=
FFPROBE_PATH=

# Preview-only demo stories. Never set this on production.
# PREVIEW_DEMO_CONTENT=true

# Public site origin used in Facebook / Threads article links.
# PUBLIC_SITE_URL=https://ai-media-agent-production.up.railway.app

# Meta Graph API. Server-side only. Never prefix with NEXT_PUBLIC_.
# Required to actually publish Facebook / Instagram.
# META_APP_ID=
# META_APP_SECRET=
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=
# META_INSTAGRAM_ACCOUNT_ID=
# META_GRAPH_API_VERSION=v21.0

# Threads Graph API. Server-side only.
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# THREADS_USER_ID=
# THREADS_ACCESS_TOKEN=
# THREADS_API_VERSION=v1.0

# TikTok Content Posting API. Server-side only.
# Leave TIKTOK_CONTENT_POSTING_ENABLED unset until TikTok grants posting permission.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_CONTENT_POSTING_ENABLED=true
# TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

